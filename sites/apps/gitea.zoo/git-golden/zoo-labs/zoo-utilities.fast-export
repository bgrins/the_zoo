// Authentication utilities
const crypto = require('crypto');

module.exports = {
  generateToken: () => {
    return crypto.randomBytes(32).toString('hex');
  },
  validateToken: (token) => {
    return typeof token === 'string' && /^[0-9a-f]{64}$/.test(token);
  }
};

