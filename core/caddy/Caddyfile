        file_server
    }
}

# Swallowed external domains - absorb telemetry/analytics requests
pdat.matterlytics.com, http://pdat.matterlytics.com {
    import logging

    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "*, Authorization"
    }
    respond 200
}

