COMPOSE_BAKE=true

# Environment variables for fresh (non-seeded) Zoo instance
COMPOSE_PROJECT_NAME=thezoo-fresh
ZOO_PROXY_PORT=3129
ZOO_NO_SEED=true
# Names the unseeded database images, so they don't replace the seeded ones
ZOO_DB_IMAGE_SUFFIX=-noseed
# Leave out the apps that run off a downloaded database dump, which ZOO_NO_SEED skips
ZOO_DUMP_APP_SCALE=0

# Network configuration to avoid conflicts with main instance
ZOO_PUBLIC_SUBNET=172.23.0.0/30
ZOO_SUBNET=172.22.0.0/16
ZOO_DNS_IP=172.22.250.2
ZOO_CADDY_IP=172.22.250.3
ZOO_PROXY_IP=172.22.250.4
